{
  "name": "hw10-volleyball-llm-wiki",
  "version": "1.0.0",
  "private": true,
  "description": "排球 LLM Wiki、18 頁教學 HTML 簡報與來源追溯",
  "engines": { "node": ">=24" },
  "scripts": {

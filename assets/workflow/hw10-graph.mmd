flowchart TD
    A["討論並確認主題、讀者與六份來源"]

    subgraph W["① 建立 LLM Wiki：ingest 與 lint"]
        B["取得原文並保存快照"]
        C{"正文可讀、版本與<br/>適用範圍清楚？"}
        D["整理重點、條號與頁碼<br/>首次整理方式先討論"]
        E["整合來源頁與主題頁<br/>更新索引、術語與操作紀錄"]
        F{"Wiki 檢查通過？"}

        B --> C
        C -- "否：補取或重新核對" --> B
        C -- "是" --> D
        D --> E
        E --> F
        F -- "引用或內容錯誤" --> D
        F -- "連結或索引錯誤" --> E
        F -- "通過，還有下一份來源" --> B
    end

    A --> B

    subgraph S["② 從 Wiki 製作教學簡報"]
        Q["依教學目標查詢 Wiki"]
        QC{"證據足夠？"}
        R["補查原文並回補 Wiki"]
        O["整理 18 頁大綱<br/>檢查教學順序、篇幅與來源"]
        H1{"H1：本人確認<br/>大綱"}
        P["撰寫整份逐頁內容<br/>主頁、補充、圖解規格與來源"]
        PC{"內容與來源<br/>檢查通過？"}
        H2{"H2：本人確認<br/>整份內容"}
        G["製作正式圖解"]
        GC{"圖解與文字、<br/>來源一致？"}
        J0{"新增 J0：建置前預檢<br/>統一換行、確認 18 頁<br/>每頁必要內容皆非空"}
        X["修正輸入或解析器"]
        J["產生 HTML 簡報與 Wiki 網頁"]
        K{"瀏覽器實測通過？<br/>內容、版面、操作<br/>與來源連結"}

        Q --> QC
        QC -- "否" --> R
        QC -- "是" --> O
        O --> H1
        H1 -- "需修改" --> O
        H1 -- "確認" --> P
        P --> PC
        PC -- "表達或條件需修正" --> P
        PC -- "證據不足" --> R
        PC -- "通過" --> H2
        H2 -- "需修改" --> P
        H2 -- "確認" --> G
        G --> GC
        GC -- "繪圖不符" --> G
        GC -- "內容規格有誤" --> P
        GC -- "通過" --> J0
        J0 -- "未通過" --> X
        X --> J0
        J0 -- "通過" --> J
        J --> K
        K -- "內容缺漏" --> J0
        K -- "版面或互動問題" --> J
        K -- "圖解問題" --> G
        K -- "核准內容本身有誤" --> P
    end

    F -- "通過，六份來源皆完成" --> Q
    R --> E

    subgraph T["③ 保存證據與公開發布"]
        L["保存執行紀錄、截圖與反思"]
        U["上傳 GitHub<br/>啟用 GitHub Pages"]
        V{"公開網址與操作<br/>檢查通過？"}
        Z["交付簡報與 Wiki 公開連結<br/>保留發布驗證紀錄"]

        L --> U
        U --> V
        V -- "發布問題" --> U
        V -- "通過" --> Z
    end

    K -- "通過" --> L
    V -- "頁面或操作問題" --> K

    classDef manual fill:#fff6d9,stroke:#9a7018,color:#60470e,stroke-width:2px;
    classDef added fill:#fff0e7,stroke:#b74b25,color:#76361e,stroke-width:3px;
    class H1,H2 manual;
    class J0 added;
